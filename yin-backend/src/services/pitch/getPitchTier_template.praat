# This script is generated at runtime by the Go server with the actual WAV filename.
# It avoids the interactive form prompt that was causing the extractor to abort.
Read from file: "__TEMP_WAV__"
selectObject: "Sound __TEMP_WAV__"
To Manipulation: 0.01, 75, 600
Extract pitch tier
Save as PitchTier spreadsheet file: "__TEMP_CSV__"
